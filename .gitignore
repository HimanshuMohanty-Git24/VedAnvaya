.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.env
dist/
build/
*.egg-info/

# Raw and generated corpus artifacts are reproducible and may carry restricted content.
data/raw/**
data/staged/**
data/canonical/**
data/derived/**
data/qa/**
!data/raw/.gitkeep
!data/staged/.gitkeep
!data/canonical/.gitkeep
!data/derived/.gitkeep
!data/qa/.gitkeep

# ...but each release's own build manifest IS tracked. Ignoring the digest along with the
# corpus destroys it in exactly the event it exists to detect -- the same way a `schema
# export` once destroyed the sealed schema, recovered only from a dangling git blob. The 20
# manifests total ~875 KB, and they hold per-file sha256, record counts and source-snapshot
# hashes rather than verse text: the only Devanagari in any of them is Wikisource page titles
# used as hash keys, so tracking them republishes no corpus and merges no licence. Recorded
# against SV-UNTRACKED-RELEASE-01. The directory must be re-included first; git cannot
# re-include a file whose parent directory is excluded.
!data/canonical/*/
data/canonical/*/*
!data/canonical/*/manifest.json


# Deterministic knowledge layer outputs are reproducible from pinned artifacts.
data/knowledge/**

# Semantic pilot outputs: model-authored candidates and evidence packets. Reproducible
# from the committed pilot config and the pinned corpus, and kept out of the repository
# so no run's raw payloads or source text are ever committed.
data/semantic/**
!data/semantic/.gitkeep

# Never commit a key.
.env.*
*.key

# Local reviewer identity is machine/session state, not semantic gold.
data/gold/.reviewer_identity.json
scratch_av_crops/
scratch_av_lines/

# Enrichment artifacts are regenerated byte-identically by
# scripts/build_enrichment.py from the canonical corpus plus data/registry/concepts.yaml,
# so the 56 MB of JSONL is derived data and follows the same rule as data/canonical.
# The manifest and the analytics summary ARE tracked: they are small, they pin the
# content digest of every artifact, and they are the record that lets a later build be
# checked against this one without regenerating it.
data/enrichment/**/*.jsonl

# local scratch (API logs, ad-hoc probes)
.tmp/

# Cached third-party audio. The catalog that describes each file is committed; the media
# is not. Binary recitation audio is large, it is reproducible from the catalog's URLs,
# and most of it belongs to a publisher who permits streaming rather than redistribution.
data/audio/cache/**
!data/audio/cache/.gitkeep

# Neo4j dumps taken before a canonical mutation. The dump itself is a ~120MB binary and is
# reproducible from the graph it was taken from; its sha256 is tracked beside it, because
# what a later reader needs is the identity of the backup a migration was gated on, not the
# bytes.
data/backup/*.dump

# The R4 pre-migration logical export: 484 MB of nodes.jsonl + relationships.jsonl,
# taken because Neo4j runs in a container on 5.26-community where `neo4j-admin database
# dump` needs the database stopped. Same rule as the dumps above -- the bytes are
# reproducible from the graph and what a later reader needs is the IDENTITY of the
# backup the migration was gated on, so MANIFEST.json and the .sha256 sidecars ARE
# tracked and the payload is not.
data/staging/release_blocker_r4/backup/*.jsonl

# The R3 and R5 logical exports, and the R2-era physical dump. Same rule and same reason as
# the R4 export above: the payload is reproducible from the graph it was taken from, and
# what a later reader needs is the IDENTITY of the backup a migration was gated on. R4 and
# R5 already track MANIFEST.json plus a .sha256 sidecar per file. R3 has no sidecars, but
# its MANIFEST.json carries both payload digests inline, so that one file is tracked and
# completes the same arrangement -- ignoring the directory wholesale would destroy the
# digest in exactly the event it exists to detect.
data/staging/release_blocker_r3/backup/*.jsonl
data/staging/release_blocker_r5/backup/*.jsonl
data/staging/final_stabilization/neo4j_backup_20260917/*.dump

# The Samaveda notation pre-import logical export: 537 MB of nodes.jsonl +
# relationships.jsonl, same rule and same reason as the R3/R4/R5 exports above. The payload
# is reproducible from the graph it was taken from and what a later reader needs is the
# IDENTITY of the backup the import was gated on, so MANIFEST.json and the .sha256 sidecars
# ARE tracked and the payload is not.
data/staging/samaveda_music_002_final/backup/*.jsonl

# Screenshot archives. `pnpm shoot` (frontend/scripts/shoot-archive.mjs --out
# ../screenshots/<name>) writes publication and visual-QA captures here: 270 PNGs and
# ~100 MB for the three archives taken during the final revamp. They are generated from
# the running product rather than authored, nothing in the app or the build reads them
# back, and no doc cites a path under screenshots/. They are publication artifacts by
# design, kept outside the repository; the final set is archived at
# D:\VedaGraph_Archive\final-screenshots-2026-09-20 with a SHA256SUMS.txt manifest.
screenshots/

# One-off V3.2 semantic-pilot scratch. scratch_prompts/ is 60 rendered prompt texts and
# the four scratch_* files are the key lists and packet dumps that selected them. All of
# it is regenerated by scripts/gen_v3_2_pilot_prompt.py, which is pure templating over
# data/semantic/.../packets.jsonl and is itself tracked. Nothing in src/, scripts/,
# tests/, docs/ or any manifest references these paths, and no seal hashes them, so they
# are working notes rather than evidence. Archived at
# D:\VedaGraph_Archive\scratch-v3-2-pilot-2026-09-20 before removal.
scratch_prompts/
scratch_keys.json
scratch_pilot_packets.json
scratch_remaining_a.json
scratch_v3_2_smoke_packets.txt
article/
reel/
