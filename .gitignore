.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.env
dist/
build/
*.egg-info/

# Raw and generated corpus artifacts are reproducible and may carry restricted content.
data/raw/**
data/staged/**
data/canonical/**
data/derived/**
data/qa/**
!data/raw/.gitkeep
!data/staged/.gitkeep
!data/canonical/.gitkeep
!data/derived/.gitkeep
!data/qa/.gitkeep

# ...but each release's own build manifest IS tracked. Ignoring the digest along with the
# corpus destroys it in exactly the event it exists to detect -- the same way a `schema
# export` once destroyed the sealed schema, recovered only from a dangling git blob. The 20
# manifests total ~875 KB, and they hold per-file sha256, record counts and source-snapshot
# hashes rather than verse text: the only Devanagari in any of them is Wikisource page titles
# used as hash keys, so tracking them republishes no corpus and merges no licence. Recorded
# against SV-UNTRACKED-RELEASE-01. The directory must be re-included first; git cannot
# re-include a file whose parent directory is excluded.
!data/canonical/*/
data/canonical/*/*
!data/canonical/*/manifest.json


# Deterministic knowledge layer outputs are reproducible from pinned artifacts.
data/knowledge/**

# Semantic pilot outputs: model-authored candidates and evidence packets. Reproducible
# from the committed pilot config and the pinned corpus, and kept out of the repository
# so no run's raw payloads or source text are ever committed.
data/semantic/**
!data/semantic/.gitkeep

# Never commit a key.
.env.*
*.key

# Local reviewer identity is machine/session state, not semantic gold.
data/gold/.reviewer_identity.json
scratch_av_crops/
scratch_av_lines/

# Enrichment artifacts are regenerated byte-identically by
# scripts/build_enrichment.py from the canonical corpus plus data/registry/concepts.yaml,
# so the 56 MB of JSONL is derived data and follows the same rule as data/canonical.
# The manifest and the analytics summary ARE tracked: they are small, they pin the
# content digest of every artifact, and they are the record that lets a later build be
# checked against this one without regenerating it.
data/enrichment/**/*.jsonl

# local scratch (API logs, ad-hoc probes)
.tmp/

# Cached third-party audio. The catalog that describes each file is committed; the media
# is not. Binary recitation audio is large, it is reproducible from the catalog's URLs,
# and most of it belongs to a publisher who permits streaming rather than redistribution.
data/audio/cache/**
!data/audio/cache/.gitkeep

# Neo4j dumps taken before a canonical mutation. The dump itself is a ~120MB binary and is
# reproducible from the graph it was taken from; its sha256 is tracked beside it, because
# what a later reader needs is the identity of the backup a migration was gated on, not the
# bytes.
data/backup/*.dump
