VEDAGRAPH_CONTACT_EMAIL=
VEDAGRAPH_USER_AGENT=VedaGraph/0.1 (+https://github.com/vedagraph/vedagraph)
VEDAGRAPH_DATA_DIR=data
VEDAGRAPH_REQUESTS_PER_SECOND=1.0
VEDAGRAPH_MAX_CONCURRENCY=2


# --- Product API (src/vedagraph/api) -------------------------------------------------
# Unprefixed on purpose: these are deployment variables, not ingestion settings.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=false


# --- Ask VedaGraph: provider-agnostic LLM layer (src/vedagraph/llm) ------------------
#
# Switch providers by changing only these variables — zero code changes required.
#
# Supported values for VEDAGRAPH_LLM_PROVIDER:
#   gemini          → Google Gemini via Google AI Studio (requires google-generativeai)
#   openai          → OpenAI (requires openai)
#   anthropic       → Anthropic Claude (requires anthropic)
#   groq            → Groq (OpenAI-compatible; requires openai)
#   openrouter      → OpenRouter (OpenAI-compatible; requires openai)
#   xai             → xAI / Grok (OpenAI-compatible; requires openai)
#   openai_compatible → any OpenAI-compatible service via VEDAGRAPH_LLM_BASE_URL
#
VEDAGRAPH_LLM_PROVIDER=gemini
VEDAGRAPH_LLM_MODEL=gemini-2.5-flash
VEDAGRAPH_LLM_API_KEY=

# Optional overrides (sensible defaults apply when omitted):
# VEDAGRAPH_LLM_BASE_URL=          # required for openai_compatible; optional override for others
# VEDAGRAPH_LLM_TIMEOUT_SECONDS=60
# VEDAGRAPH_LLM_MAX_OUTPUT_TOKENS=4096
# VEDAGRAPH_LLM_TEMPERATURE=0.1
# VEDAGRAPH_LLM_MAX_RETRIES=3
# VEDAGRAPH_LLM_STREAM=false

# Backward-compatible fallback key names (used only when VEDAGRAPH_LLM_API_KEY is absent):
# GOOGLE_API_KEY=                  # Google AI Studio key for Gemini
# GEMINI_API_KEY=                  # alternative Gemini key variable
# OPENAI_API_KEY=                  # OpenAI key
# ANTHROPIC_API_KEY=               # Anthropic key
