{
  "additionalProperties": false,
  "description": "Pinned provenance for the offline normalization diagnostic.",
  "properties": {
    "comparison_policy_version": {
      "default": "rigveda-semantic-object-comparison-v1",
      "title": "Comparison Policy Version",
      "type": "string"
    },
    "corpus_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Corpus Manifest Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "explicitness_policy_version": {
      "default": "rigveda-semantic-explicitness-v2",
      "title": "Explicitness Policy Version",
      "type": "string"
    },
    "human_gold_status": {
      "const": "UNANNOTATED",
      "default": "UNANNOTATED",
      "title": "Human Gold Status",
      "type": "string"
    },
    "input_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Input Hashes",
      "type": "object"
    },
    "lexical_knowledge_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Lexical Knowledge Manifest Sha256",
      "type": "string"
    },
    "luna_v1_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Luna V1 Manifest Sha256",
      "type": "string"
    },
    "luna_v2_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Luna V2 Manifest Sha256",
      "type": "string"
    },
    "model_execution": {
      "const": false,
      "default": false,
      "title": "Model Execution",
      "type": "boolean"
    },
    "output_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Output Hashes",
      "type": "object"
    },
    "record_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Record Counts",
      "type": "object"
    },
    "run_id": {
      "const": "vedagraph-rigveda-semantic-normalization-v1",
      "default": "vedagraph-rigveda-semantic-normalization-v1",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_object_schema_version": {
      "default": "rigveda-semantic-object-v1",
      "title": "Semantic Object Schema Version",
      "type": "string"
    },
    "semantic_ontology_version": {
      "minLength": 1,
      "title": "Semantic Ontology Version",
      "type": "string"
    },
    "sol_silver_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Sol Silver Manifest Sha256",
      "type": "string"
    },
    "traditional_knowledge_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Traditional Knowledge Manifest Sha256",
      "type": "string"
    },
    "unlocked_predicates": {
      "items": {
        "type": "string"
      },
      "maxItems": 0,
      "title": "Unlocked Predicates",
      "type": "array"
    }
  },
  "required": [
    "corpus_manifest_sha256",
    "traditional_knowledge_manifest_sha256",
    "lexical_knowledge_manifest_sha256",
    "luna_v1_manifest_sha256",
    "luna_v2_manifest_sha256",
    "sol_silver_manifest_sha256",
    "semantic_ontology_version",
    "input_hashes",
    "output_hashes",
    "record_counts",
    "created_at"
  ],
  "title": "SemanticNormalizationManifest",
  "type": "object"
}
