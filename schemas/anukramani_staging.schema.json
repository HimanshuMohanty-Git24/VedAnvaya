{
  "$defs": {
    "AnukramaniField": {
      "description": "The three annotated fields of one Anukramaṇī row.",
      "enum": [
        "SEER",
        "DIVINITY",
        "METER"
      ],
      "title": "AnukramaniField",
      "type": "string"
    },
    "AnukramaniParseStatus": {
      "description": "Fail-closed status of one parsed Anukramaṇī row.",
      "enum": [
        "PARSED",
        "PARTIALLY_PARSED",
        "INVALID"
      ],
      "title": "AnukramaniParseStatus",
      "type": "string"
    },
    "AnukramaniSegment": {
      "additionalProperties": false,
      "description": "One comma-separated segment of one Anukramaṇī field, kept verbatim.",
      "properties": {
        "end_mantra": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Mantra"
        },
        "field": {
          "$ref": "#/$defs/AnukramaniField"
        },
        "raw_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Scope"
        },
        "raw_segment": {
          "minLength": 1,
          "title": "Raw Segment",
          "type": "string"
        },
        "raw_value": {
          "minLength": 1,
          "title": "Raw Value",
          "type": "string"
        },
        "scope_origin": {
          "$ref": "#/$defs/ScopeOrigin"
        },
        "start_mantra": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Mantra"
        }
      },
      "required": [
        "field",
        "raw_segment",
        "raw_value",
        "scope_origin"
      ],
      "title": "AnukramaniSegment",
      "type": "object"
    },
    "ScopeOrigin": {
      "description": "The scope the source itself stated, before expansion to mantras.",
      "enum": [
        "SUKTA_WIDE",
        "MANTRA_RANGE",
        "SINGLE_MANTRA"
      ],
      "title": "ScopeOrigin",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One parsed Anukramaṇī row. Adapters produce these and nothing canonical.",
  "properties": {
    "declared_verse_count": {
      "minimum": 1,
      "title": "Declared Verse Count",
      "type": "integer"
    },
    "line_number": {
      "minimum": 1,
      "title": "Line Number",
      "type": "integer"
    },
    "mandala": {
      "minimum": 1,
      "title": "Mandala",
      "type": "integer"
    },
    "parse_notes": {
      "items": {
        "type": "string"
      },
      "title": "Parse Notes",
      "type": "array"
    },
    "parse_status": {
      "$ref": "#/$defs/AnukramaniParseStatus"
    },
    "parser_version": {
      "title": "Parser Version",
      "type": "string"
    },
    "raw_divinity_field": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Divinity Field"
    },
    "raw_line": {
      "minLength": 1,
      "title": "Raw Line",
      "type": "string"
    },
    "raw_meter_field": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Meter Field"
    },
    "raw_seer_field": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Seer Field"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/AnukramaniSegment"
      },
      "title": "Segments",
      "type": "array"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_artifact_id": {
      "title": "Source Artifact Id",
      "type": "string"
    },
    "source_id": {
      "default": "WSC2023",
      "title": "Source Id",
      "type": "string"
    },
    "source_locator": {
      "title": "Source Locator",
      "type": "string"
    },
    "sukta": {
      "minimum": 1,
      "title": "Sukta",
      "type": "integer"
    },
    "work_id": {
      "default": "VG:WORK:RV:SAK",
      "title": "Work Id",
      "type": "string"
    }
  },
  "required": [
    "source_artifact_id",
    "snapshot_id",
    "source_locator",
    "raw_line",
    "line_number",
    "mandala",
    "sukta",
    "declared_verse_count",
    "parse_status",
    "parser_version"
  ],
  "title": "AnukramaniStagingRecord",
  "type": "object"
}
