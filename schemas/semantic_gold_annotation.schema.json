{
  "$defs": {
    "Explicitness": {
      "description": "How the model says it got there. Self-reported, and validated against evidence.",
      "enum": [
        "EXPLICIT",
        "STRONG_INFERENCE",
        "INTERPRETIVE"
      ],
      "title": "Explicitness",
      "type": "string"
    },
    "GoldRelation": {
      "additionalProperties": false,
      "description": "One relation a human annotator says is present, or says is tempting but absent.",
      "properties": {
        "explicitness": {
          "$ref": "#/$defs/Explicitness"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "object_entity_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Entity Key"
        },
        "object_label": {
          "minLength": 1,
          "title": "Object Label",
          "type": "string"
        },
        "object_node_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemanticNodeType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "predicate": {
          "$ref": "#/$defs/SemanticPredicate"
        },
        "rejected": {
          "default": false,
          "title": "Rejected",
          "type": "boolean"
        }
      },
      "required": [
        "predicate",
        "object_label",
        "explicitness"
      ],
      "title": "GoldRelation",
      "type": "object"
    },
    "SemanticNodeType": {
      "description": "Categories a semantic entity may belong to.\n\nChosen to be usable across the four Vedas, not tuned to the Rigveda. Adding a type\nis an ontology version bump, because every stored candidate names the version it was\nproduced under.",
      "enum": [
        "CONCEPT",
        "PHILOSOPHICAL_CONCEPT",
        "THEME",
        "RITUAL",
        "OFFERING",
        "SUBSTANCE",
        "PLANT",
        "ANIMAL",
        "OBJECT",
        "PLACE",
        "RIVER",
        "REGION",
        "NATURAL_PHENOMENON",
        "COSMIC_ENTITY",
        "ACTION",
        "QUALITY",
        "STATE"
      ],
      "title": "SemanticNodeType",
      "type": "string"
    },
    "SemanticPredicate": {
      "description": "Every relation name an extraction may emit, and the ones it may not.\n\nThe forbidden members exist so that a proposal naming one is rejected as a *policy*\ndecision with a recorded reason, instead of failing schema validation as an unknown\nstring. The difference matters when reading a rejection report.",
      "enum": [
        "EXPRESSES",
        "DESCRIBES",
        "PRAISES",
        "INVOKES",
        "REQUESTS",
        "ASSOCIATED_WITH",
        "INVOLVES_RITUAL",
        "INVOLVES_OFFERING",
        "INVOLVES_SUBSTANCE",
        "REFERS_TO_PLACE",
        "REFERS_TO_NATURAL_PHENOMENON",
        "DESCRIBES_ACTION",
        "HAS_THEME",
        "CONTRASTS_WITH",
        "SYMBOLIZES",
        "REPRESENTS",
        "IS_GOD_OF",
        "MEANS",
        "CAUSES"
      ],
      "title": "SemanticPredicate",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The reviewed expectation for one mantra. Written by a person, never by a model.",
  "properties": {
    "annotated_at": {
      "format": "date-time",
      "title": "Annotated At",
      "type": "string"
    },
    "annotator": {
      "minLength": 1,
      "title": "Annotator",
      "type": "string"
    },
    "citation": {
      "minLength": 1,
      "title": "Citation",
      "type": "string"
    },
    "entities": {
      "items": {
        "type": "string"
      },
      "title": "Entities",
      "type": "array"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    },
    "passage_key": {
      "pattern": "^VG:RV:SAK:M\\d{2}:S\\d{3}:V\\d{3}$",
      "title": "Passage Key",
      "type": "string"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/GoldRelation"
      },
      "title": "Relations",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "passage_key",
    "citation",
    "annotator",
    "annotated_at"
  ],
  "title": "GoldAnnotation",
  "type": "object"
}
