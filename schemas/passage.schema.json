{
  "$defs": {
    "EntityType": {
      "enum": [
        "WORK",
        "SECTION",
        "HYMN",
        "MANTRA"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "PassageStatus": {
      "enum": [
        "DRAFT",
        "CANONICAL",
        "DEPRECATED"
      ],
      "title": "PassageStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "canonical_citation": {
      "title": "Canonical Citation",
      "type": "string"
    },
    "canonical_key": {
      "pattern": "^VG:[A-Z]+:[A-Z]+:.+$",
      "title": "Canonical Key",
      "type": "string"
    },
    "canonical_urn": {
      "pattern": "^urn:vedagraph:",
      "title": "Canonical Urn",
      "type": "string"
    },
    "entity_id": {
      "format": "uuid",
      "title": "Entity Id",
      "type": "string"
    },
    "entity_type": {
      "$ref": "#/$defs/EntityType"
    },
    "hierarchy": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ]
      },
      "title": "Hierarchy",
      "type": "object"
    },
    "parent_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Key"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence_in_parent": {
      "minimum": 1,
      "title": "Sequence In Parent",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/PassageStatus",
      "default": "CANONICAL"
    },
    "work_id": {
      "title": "Work Id",
      "type": "string"
    }
  },
  "required": [
    "entity_id",
    "canonical_key",
    "canonical_urn",
    "entity_type",
    "work_id",
    "hierarchy",
    "canonical_citation",
    "sequence_in_parent"
  ],
  "title": "Passage",
  "type": "object"
}
