{
  "$defs": {
    "RightsStatus": {
      "enum": [
        "PUBLIC_DOMAIN",
        "CC_BY",
        "CC_BY_SA",
        "CC_BY_NC",
        "CC_BY_NC_SA",
        "APACHE_2_0",
        "PERMISSION_GRANTED",
        "PERMISSION_REQUIRED",
        "RESEARCH_ONLY",
        "REFERENCE_ONLY",
        "EXTERNAL_REFERENCE_ONLY",
        "UNKNOWN"
      ],
      "title": "RightsStatus",
      "type": "string"
    },
    "TextForm": {
      "enum": [
        "SAMHITA",
        "PADAPATHA",
        "OTHER"
      ],
      "title": "TextForm",
      "type": "string"
    },
    "TextRole": {
      "description": "How VedaGraph is allowed to use one Sanskrit textual representation.",
      "enum": [
        "PRIMARY_TEXT",
        "PARALLEL_TEXT",
        "PADAPATHA",
        "METRICALLY_RESTORED",
        "NORMALIZED",
        "SEARCH_DERIVATIVE",
        "DISPLAY_DERIVATIVE",
        "LINGUISTIC_ANNOTATION",
        "COMPARISON_ONLY",
        "REFERENCE_ONLY"
      ],
      "title": "TextRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accented": {
      "title": "Accented",
      "type": "boolean"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "passage_id": {
      "format": "uuid",
      "title": "Passage Id",
      "type": "string"
    },
    "rights_status": {
      "$ref": "#/$defs/RightsStatus"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "script": {
      "title": "Script",
      "type": "string"
    },
    "source_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Artifact Id"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_locator": {
      "title": "Source Locator",
      "type": "string"
    },
    "text_form": {
      "$ref": "#/$defs/TextForm"
    },
    "text_id": {
      "format": "uuid",
      "title": "Text Id",
      "type": "string"
    },
    "text_nfc": {
      "minLength": 1,
      "title": "Text Nfc",
      "type": "string"
    },
    "text_original": {
      "minLength": 1,
      "title": "Text Original",
      "type": "string"
    },
    "text_role": {
      "$ref": "#/$defs/TextRole",
      "default": "PRIMARY_TEXT"
    },
    "text_version_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text Version Id"
    },
    "transliteration_scheme": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transliteration Scheme"
    }
  },
  "required": [
    "text_id",
    "passage_id",
    "language",
    "script",
    "text_form",
    "text_original",
    "text_nfc",
    "accented",
    "source_id",
    "source_locator",
    "content_sha256",
    "rights_status"
  ],
  "title": "TextVersion",
  "type": "object"
}
