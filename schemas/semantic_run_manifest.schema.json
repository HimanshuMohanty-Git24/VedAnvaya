{
  "$defs": {
    "TokenUsage": {
      "additionalProperties": false,
      "description": "Actual usage reported by the API. Never an estimate when a real number exists.",
      "properties": {
        "cached_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cached Input Tokens",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reasoning_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Reasoning Tokens",
          "type": "integer"
        },
        "requests": {
          "default": 0,
          "minimum": 0,
          "title": "Requests",
          "type": "integer"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What was run, against what, with which configuration, and what it produced.",
  "properties": {
    "acceptance_policy_version": {
      "minLength": 1,
      "title": "Acceptance Policy Version",
      "type": "string"
    },
    "api_invocation": {
      "default": false,
      "title": "Api Invocation",
      "type": "boolean"
    },
    "batch_count": {
      "default": 0,
      "minimum": 0,
      "title": "Batch Count",
      "type": "integer"
    },
    "batch_size": {
      "default": 0,
      "minimum": 0,
      "title": "Batch Size",
      "type": "integer"
    },
    "cached_input_cost_usd_per_million": {
      "minimum": 0.0,
      "title": "Cached Input Cost Usd Per Million",
      "type": "number"
    },
    "corpus_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Corpus Manifest Sha256",
      "type": "string"
    },
    "corpus_version": {
      "minLength": 1,
      "title": "Corpus Version",
      "type": "string"
    },
    "dataset_id": {
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "extraction_runtime": {
      "default": "API",
      "title": "Extraction Runtime",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "gold_status": {
      "default": "UNANNOTATED",
      "title": "Gold Status",
      "type": "string"
    },
    "input_cost_usd_per_million": {
      "minimum": 0.0,
      "title": "Input Cost Usd Per Million",
      "type": "number"
    },
    "lexical_knowledge_manifest_sha256": {
      "default": "",
      "title": "Lexical Knowledge Manifest Sha256",
      "type": "string"
    },
    "lexical_policy_version": {
      "minLength": 1,
      "title": "Lexical Policy Version",
      "type": "string"
    },
    "max_output_tokens": {
      "minimum": 1,
      "title": "Max Output Tokens",
      "type": "integer"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "model_snapshot": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Snapshot"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    },
    "ontology_version": {
      "minLength": 1,
      "title": "Ontology Version",
      "type": "string"
    },
    "output_cost_usd_per_million": {
      "minimum": 0.0,
      "title": "Output Cost Usd Per Million",
      "type": "number"
    },
    "output_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Output Hashes",
      "type": "object"
    },
    "packet_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Packet Hashes",
      "type": "object"
    },
    "packet_version": {
      "minLength": 1,
      "title": "Packet Version",
      "type": "string"
    },
    "passage_count": {
      "minimum": 0,
      "title": "Passage Count",
      "type": "integer"
    },
    "pilot_config_sha256": {
      "default": "",
      "title": "Pilot Config Sha256",
      "type": "string"
    },
    "prompt_sha256": {
      "default": "",
      "title": "Prompt Sha256",
      "type": "string"
    },
    "prompt_version": {
      "minLength": 1,
      "title": "Prompt Version",
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "qa_result": {
      "default": "",
      "title": "Qa Result",
      "type": "string"
    },
    "reasoning_effort": {
      "minLength": 1,
      "title": "Reasoning Effort",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_name": {
      "minLength": 1,
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "temperature": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature"
    },
    "total_cost_usd": {
      "default": 0.0,
      "minimum": 0.0,
      "title": "Total Cost Usd",
      "type": "number"
    },
    "traditional_knowledge_manifest_sha256": {
      "default": "",
      "title": "Traditional Knowledge Manifest Sha256",
      "type": "string"
    },
    "unlocked_predicates": {
      "items": {
        "type": "string"
      },
      "title": "Unlocked Predicates",
      "type": "array"
    },
    "usage": {
      "$ref": "#/$defs/TokenUsage"
    },
    "validator_version": {
      "default": "",
      "title": "Validator Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "dataset_id",
    "started_at",
    "corpus_version",
    "corpus_manifest_sha256",
    "lexical_policy_version",
    "ontology_version",
    "acceptance_policy_version",
    "prompt_version",
    "packet_version",
    "schema_name",
    "provider",
    "model",
    "reasoning_effort",
    "max_output_tokens",
    "passage_count",
    "input_cost_usd_per_million",
    "cached_input_cost_usd_per_million",
    "output_cost_usd_per_million"
  ],
  "title": "SemanticRunManifest",
  "type": "object"
}
