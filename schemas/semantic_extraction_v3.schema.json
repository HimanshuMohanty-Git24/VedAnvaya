{
  "$defs": {
    "ActionEvent": {
      "additionalProperties": false,
      "description": "An occurrence-level action; absent arguments stay absent.",
      "properties": {
        "action_head": {
          "minLength": 1,
          "title": "Action Head",
          "type": "string"
        },
        "actor_entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor Entity Id"
        },
        "other_participants": {
          "items": {
            "$ref": "#/$defs/EventParticipant"
          },
          "title": "Other Participants",
          "type": "array"
        },
        "patient_entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Patient Entity Id"
        },
        "qualifiers": {
          "items": {
            "type": "string"
          },
          "title": "Qualifiers",
          "type": "array"
        }
      },
      "required": [
        "action_head"
      ],
      "title": "ActionEvent",
      "type": "object"
    },
    "EventParticipant": {
      "additionalProperties": false,
      "description": "One evidenced event role; the role vocabulary is intentionally not canonicalized.",
      "properties": {
        "entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "normalized_head": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Head"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role"
      ],
      "title": "EventParticipant",
      "type": "object"
    },
    "Explicitness": {
      "description": "How the model says it got there. Self-reported, and validated against evidence.",
      "enum": [
        "EXPLICIT",
        "STRONG_INFERENCE"
      ],
      "title": "Explicitness",
      "type": "string"
    },
    "SemanticEvidenceAnchor": {
      "additionalProperties": false,
      "description": "Deterministic references justifying an occurrence-level semantic object.",
      "properties": {
        "other_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Other Evidence Ids",
          "type": "array"
        },
        "passage_ids": {
          "items": {
            "type": "string"
          },
          "title": "Passage Ids",
          "type": "array"
        },
        "source_passage_id": {
          "minLength": 1,
          "title": "Source Passage Id",
          "type": "string"
        },
        "token_ids": {
          "items": {
            "type": "string"
          },
          "title": "Token Ids",
          "type": "array"
        },
        "translation_record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Translation Record Id"
        },
        "translation_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/TranslationSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "source_passage_id"
      ],
      "title": "SemanticEvidenceAnchor",
      "type": "object"
    },
    "SemanticObjectCandidate": {
      "additionalProperties": false,
      "description": "An evidenced occurrence candidate, never a global canonical semantic concept.",
      "properties": {
        "beneficiary_entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Beneficiary Entity Id"
        },
        "candidate_id": {
          "pattern": "^VG:SEMOBJ:[A-F0-9]{20}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "canonical_entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Entity Id"
        },
        "display_label": {
          "minLength": 1,
          "title": "Display Label",
          "type": "string"
        },
        "event": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActionEvent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SemanticEvidenceAnchor"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "extraction_model": {
          "minLength": 1,
          "title": "Extraction Model",
          "type": "string"
        },
        "legacy_object_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legacy Object Id"
        },
        "normalization_status": {
          "$ref": "#/$defs/SemanticObjectNormalizationStatus"
        },
        "normalized_head": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Head"
        },
        "object_kind": {
          "$ref": "#/$defs/SemanticObjectKind"
        },
        "ontology_gap_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemanticOntologyGapCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prompt_version": {
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "qualifiers": {
          "items": {
            "type": "string"
          },
          "title": "Qualifiers",
          "type": "array"
        },
        "schema_version": {
          "default": "rigveda-semantic-object-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_passage_id": {
          "minLength": 1,
          "title": "Source Passage Id",
          "type": "string"
        },
        "target_entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Entity Id"
        }
      },
      "required": [
        "candidate_id",
        "object_kind",
        "display_label",
        "source_passage_id",
        "evidence",
        "extraction_model",
        "prompt_version",
        "normalization_status"
      ],
      "title": "SemanticObjectCandidate",
      "type": "object"
    },
    "SemanticObjectKind": {
      "description": "Occurrence-level object families; none is a canonical concept by itself.",
      "enum": [
        "CANONICAL_ENTITY_REF",
        "SEMANTIC_ENTITY_REF",
        "EVENT",
        "REQUESTED_OUTCOME",
        "RITUAL_EVENT",
        "OFFERING_REF",
        "SUBSTANCE_REF",
        "NATURAL_PHENOMENON_REF",
        "PLACE_REF",
        "STATE_REF",
        "QUALITY_REF",
        "CONCEPT_REF",
        "ACTION_REF",
        "OPAQUE_REFERENT",
        "OPAQUE_SPATIAL_REFERENT",
        "ONTOLOGY_GAP_REF"
      ],
      "title": "SemanticObjectKind",
      "type": "string"
    },
    "SemanticObjectNormalizationStatus": {
      "description": "How far an occurrence has progressed toward reviewed normalization.",
      "enum": [
        "CANONICAL_REF",
        "NORMALIZED_CANDIDATE",
        "NEEDS_REVIEW",
        "AMBIGUOUS",
        "ONTOLOGY_GAP",
        "UNRESOLVED_LEGACY_OBJECT"
      ],
      "title": "SemanticObjectNormalizationStatus",
      "type": "string"
    },
    "SemanticOntologyGapCode": {
      "description": "Specific gaps exposed without forcing an incorrect ontology type.",
      "enum": [
        "PERSON_LIKE_REFERENT_UNMODELED",
        "PATRON_ROLE_UNMODELED",
        "ANCESTOR_ROLE_UNMODELED",
        "KINSHIP_ROLE_UNMODELED",
        "OTHER_UNMODELED"
      ],
      "title": "SemanticOntologyGapCode",
      "type": "string"
    },
    "SemanticPredicate": {
      "description": "Every relation name an extraction may emit, and the ones it may not.\n\nThe forbidden members exist so that a proposal naming one is rejected as a *policy*\ndecision with a recorded reason, instead of failing schema validation as an unknown\nstring. The difference matters when reading a rejection report.",
      "enum": [
        "EXPRESSES",
        "DESCRIBES",
        "PRAISES",
        "INVOKES",
        "REQUESTS",
        "ASSOCIATED_WITH",
        "INVOLVES_RITUAL",
        "INVOLVES_OFFERING",
        "INVOLVES_SUBSTANCE",
        "REFERS_TO_PLACE",
        "REFERS_TO_NATURAL_PHENOMENON",
        "DESCRIBES_ACTION",
        "HAS_THEME",
        "CONTRASTS_WITH",
        "SYMBOLIZES",
        "REPRESENTS",
        "IS_GOD_OF",
        "MEANS",
        "CAUSES"
      ],
      "title": "SemanticPredicate",
      "type": "string"
    },
    "StructuredSemanticAssertion": {
      "additionalProperties": false,
      "description": "A migrated or native-v3 assertion whose object is an occurrence candidate.",
      "properties": {
        "assertion_id": {
          "minLength": 1,
          "title": "Assertion Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SemanticEvidenceAnchor"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "explicitness": {
          "$ref": "#/$defs/Explicitness"
        },
        "inference_step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inference Step"
        },
        "legacy_assertion_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legacy Assertion Id"
        },
        "object": {
          "$ref": "#/$defs/SemanticObjectCandidate"
        },
        "predicate": {
          "$ref": "#/$defs/SemanticPredicate"
        },
        "schema_version": {
          "default": "rigveda-semantic-object-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_run_id": {
          "minLength": 1,
          "title": "Source Run Id",
          "type": "string"
        },
        "subject_id": {
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "assertion_id",
        "source_run_id",
        "subject_id",
        "predicate",
        "object",
        "evidence",
        "explicitness"
      ],
      "title": "StructuredSemanticAssertion",
      "type": "object"
    },
    "TranslationSpan": {
      "additionalProperties": false,
      "description": "Half-open character offsets into a pinned translation record.",
      "properties": {
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TranslationSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Typed, evidence-anchored occurrence payload for the Rigveda v3 pilot.",
  "properties": {
    "assertions": {
      "items": {
        "$ref": "#/$defs/StructuredSemanticAssertion"
      },
      "title": "Assertions",
      "type": "array"
    },
    "mantra_id": {
      "title": "Mantra Id",
      "type": "string"
    },
    "no_claim_reasons": {
      "items": {
        "type": "string"
      },
      "title": "No Claim Reasons",
      "type": "array"
    },
    "object_schema_version": {
      "const": "rigveda-semantic-object-v1",
      "default": "rigveda-semantic-object-v1",
      "title": "Object Schema Version",
      "type": "string"
    },
    "ontology_gaps": {
      "items": {
        "$ref": "#/$defs/SemanticObjectCandidate"
      },
      "title": "Ontology Gaps",
      "type": "array"
    },
    "prompt_version": {
      "const": "rigveda-semantic-extraction-v3",
      "default": "rigveda-semantic-extraction-v3",
      "title": "Prompt Version",
      "type": "string"
    }
  },
  "required": [
    "mantra_id"
  ],
  "title": "SemanticExtractionV3",
  "type": "object"
}
