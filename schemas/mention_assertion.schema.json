{
  "$defs": {
    "KnowledgeEntityType": {
      "description": "Canonical entity families in the deterministic knowledge layer.",
      "enum": [
        "RISHI",
        "DEVATA",
        "CHANDAS"
      ],
      "title": "KnowledgeEntityType",
      "type": "string"
    },
    "LexicalPredicate": {
      "description": "Deterministic predicates added by the lexical / cross-mantra layer.\n\n``HAS_RISHI``, ``HAS_DEVATA`` and ``HAS_CHANDAS`` are *not* here: traditional\nassignment lives in :class:`MetadataPredicate` and is never conflated with\nlexical evidence.",
      "enum": [
        "MENTIONS_ENTITY",
        "EXACT_PARALLEL_OF",
        "PARALLEL_TO",
        "HAS_COMPONENT"
      ],
      "title": "LexicalPredicate",
      "type": "string"
    },
    "LexicalProvenanceClass": {
      "description": "What kind of statement a lexical-layer assertion rests on.\n\nThese never mix with :class:`ProvenanceClass`, whose members describe claims\nread directly out of the Anukramaṇī.",
      "enum": [
        "DETERMINISTIC_DERIVED",
        "HUMAN_REVIEWED"
      ],
      "title": "LexicalProvenanceClass",
      "type": "string"
    },
    "MentionEvidence": {
      "additionalProperties": false,
      "description": "One token that evidences a mention, precise enough to highlight in a UI.",
      "properties": {
        "alias_id": {
          "format": "uuid",
          "title": "Alias Id",
          "type": "string"
        },
        "alias_key": {
          "minLength": 1,
          "title": "Alias Key",
          "type": "string"
        },
        "lemma": {
          "minLength": 1,
          "title": "Lemma",
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/MentionMethod"
        },
        "pada": {
          "pattern": "^[a-z]$",
          "title": "Pada",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "surface": {
          "minLength": 1,
          "title": "Surface",
          "type": "string"
        },
        "token_id": {
          "format": "uuid",
          "title": "Token Id",
          "type": "string"
        },
        "token_key": {
          "minLength": 1,
          "title": "Token Key",
          "type": "string"
        }
      },
      "required": [
        "token_id",
        "token_key",
        "sequence",
        "pada",
        "surface",
        "lemma",
        "alias_id",
        "alias_key",
        "method"
      ],
      "title": "MentionEvidence",
      "type": "object"
    },
    "MentionMethod": {
      "description": "How one token was matched to a canonical entity.\n\nOrdered strongest first. ``LEMMA_ID_EXACT`` rests on the annotation source's\nown stable lemma identifier and involves no string comparison at all.",
      "enum": [
        "LEMMA_ID_EXACT",
        "LEMMA_EXACT",
        "LEMMA_NORMALIZED_EXACT",
        "SURFACE_EXACT"
      ],
      "title": "MentionMethod",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One mantra mentions one canonical entity, with every occurrence recorded.\n\nA mantra naming the same entity three times produces one edge whose evidence lists\nthree tokens: the graph stays simple, the textual record stays complete.",
  "properties": {
    "annotation_layer_id": {
      "minLength": 1,
      "title": "Annotation Layer Id",
      "type": "string"
    },
    "assertion_id": {
      "format": "uuid",
      "title": "Assertion Id",
      "type": "string"
    },
    "citation": {
      "minLength": 1,
      "title": "Citation",
      "type": "string"
    },
    "entity_type": {
      "$ref": "#/$defs/KnowledgeEntityType"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/MentionEvidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "mention_policy_version": {
      "minLength": 1,
      "title": "Mention Policy Version",
      "type": "string"
    },
    "methods": {
      "items": {
        "$ref": "#/$defs/MentionMethod"
      },
      "minItems": 1,
      "title": "Methods",
      "type": "array"
    },
    "object_id": {
      "format": "uuid",
      "title": "Object Id",
      "type": "string"
    },
    "object_key": {
      "pattern": "^VG:(RISHI|DEVATA):[A-Z0-9-]+$",
      "title": "Object Key",
      "type": "string"
    },
    "occurrence_count": {
      "minimum": 1,
      "title": "Occurrence Count",
      "type": "integer"
    },
    "predicate": {
      "$ref": "#/$defs/LexicalPredicate",
      "default": "MENTIONS_ENTITY"
    },
    "provenance_class": {
      "$ref": "#/$defs/LexicalProvenanceClass",
      "default": "DETERMINISTIC_DERIVED"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_artifact_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Artifact Ids",
      "type": "array"
    },
    "subject_id": {
      "format": "uuid",
      "title": "Subject Id",
      "type": "string"
    },
    "subject_key": {
      "pattern": "^VG:RV:SAK:M\\d{2}:S\\d{3}:V\\d{3}$",
      "title": "Subject Key",
      "type": "string"
    }
  },
  "required": [
    "assertion_id",
    "subject_key",
    "subject_id",
    "object_key",
    "object_id",
    "entity_type",
    "occurrence_count",
    "evidence",
    "methods",
    "annotation_layer_id",
    "source_artifact_ids",
    "mention_policy_version",
    "citation"
  ],
  "title": "MentionAssertion",
  "type": "object"
}
