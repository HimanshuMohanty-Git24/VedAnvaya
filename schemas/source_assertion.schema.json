{
  "$defs": {
    "AssertionStatus": {
      "enum": [
        "UNREVIEWED",
        "ACCEPTED",
        "REJECTED",
        "CONFLICT",
        "SUPERSEDED",
        "NEEDS_REVIEW"
      ],
      "title": "AssertionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asserted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Asserted At"
    },
    "assertion_id": {
      "format": "uuid",
      "title": "Assertion Id",
      "type": "string"
    },
    "evidence": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence"
    },
    "predicate": {
      "title": "Predicate",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Artifact Id"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_locator": {
      "title": "Source Locator",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AssertionStatus",
      "default": "UNREVIEWED"
    },
    "subject_id": {
      "title": "Subject Id",
      "type": "string"
    },
    "value": {
      "title": "Value"
    }
  },
  "required": [
    "assertion_id",
    "subject_id",
    "predicate",
    "value",
    "source_id",
    "source_locator"
  ],
  "title": "SourceAssertion",
  "type": "object"
}
