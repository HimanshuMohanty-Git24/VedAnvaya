{
  "$defs": {
    "DiscoveryAvailability": {
      "enum": [
        "AVAILABLE",
        "REFERENCE_ONLY",
        "UNKNOWN"
      ],
      "title": "DiscoveryAvailability",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "availability": {
      "$ref": "#/$defs/DiscoveryAvailability"
    },
    "canonical_sukta_key": {
      "title": "Canonical Sukta Key",
      "type": "string"
    },
    "discovered_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Discovered At"
    },
    "discovery_source": {
      "title": "Discovery Source",
      "type": "string"
    },
    "known_mantra_count": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Known Mantra Count"
    },
    "mandala_number": {
      "minimum": 1,
      "title": "Mandala Number",
      "type": "integer"
    },
    "parent_mandala_key": {
      "title": "Parent Mandala Key",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Artifact Id"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_locator": {
      "title": "Source Locator",
      "type": "string"
    },
    "sukta_number": {
      "minimum": 1,
      "title": "Sukta Number",
      "type": "integer"
    }
  },
  "required": [
    "canonical_sukta_key",
    "sukta_number",
    "mandala_number",
    "parent_mandala_key",
    "source_id",
    "source_locator",
    "availability",
    "discovery_source",
    "snapshot_id"
  ],
  "title": "SuktaDiscoveryRecord",
  "type": "object"
}
