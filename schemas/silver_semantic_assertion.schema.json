{
  "$defs": {
    "Explicitness": {
      "description": "How the model says it got there. Self-reported, and validated against evidence.",
      "enum": [
        "EXPLICIT",
        "STRONG_INFERENCE",
        "INTERPRETIVE"
      ],
      "title": "Explicitness",
      "type": "string"
    },
    "SemanticNodeType": {
      "description": "Categories a semantic entity may belong to.\n\nChosen to be usable across the four Vedas, not tuned to the Rigveda. Adding a type\nis an ontology version bump, because every stored candidate names the version it was\nproduced under.",
      "enum": [
        "CONCEPT",
        "PHILOSOPHICAL_CONCEPT",
        "THEME",
        "RITUAL",
        "OFFERING",
        "SUBSTANCE",
        "PLANT",
        "ANIMAL",
        "OBJECT",
        "PLACE",
        "RIVER",
        "REGION",
        "NATURAL_PHENOMENON",
        "COSMIC_ENTITY",
        "ACTION",
        "QUALITY",
        "STATE"
      ],
      "title": "SemanticNodeType",
      "type": "string"
    },
    "SemanticPredicate": {
      "description": "Every relation name an extraction may emit, and the ones it may not.\n\nThe forbidden members exist so that a proposal naming one is rejected as a *policy*\ndecision with a recorded reason, instead of failing schema validation as an unknown\nstring. The difference matters when reading a rejection report.",
      "enum": [
        "EXPRESSES",
        "DESCRIBES",
        "PRAISES",
        "INVOKES",
        "REQUESTS",
        "ASSOCIATED_WITH",
        "INVOLVES_RITUAL",
        "INVOLVES_OFFERING",
        "INVOLVES_SUBSTANCE",
        "REFERS_TO_PLACE",
        "REFERS_TO_NATURAL_PHENOMENON",
        "DESCRIBES_ACTION",
        "HAS_THEME",
        "CONTRASTS_WITH",
        "SYMBOLIZES",
        "REPRESENTS",
        "IS_GOD_OF",
        "MEANS",
        "CAUSES"
      ],
      "title": "SemanticPredicate",
      "type": "string"
    },
    "SilverEvidenceReference": {
      "additionalProperties": false,
      "description": "An identifier inside the EvidencePacket used for the independent judgment.",
      "properties": {
        "kind": {
          "enum": [
            "PASSAGE",
            "TRANSLATION",
            "TOKEN",
            "ENTITY",
            "PARALLEL"
          ],
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "reference_id": {
          "minLength": 1,
          "title": "Reference Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reference_id"
      ],
      "title": "SilverEvidenceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One conservative relation independently supported by the packet.",
  "properties": {
    "assertion_id": {
      "minLength": 1,
      "title": "Assertion Id",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/SilverEvidenceReference"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "explicitness": {
      "$ref": "#/$defs/Explicitness"
    },
    "object_entity_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Object Entity Key"
    },
    "object_label": {
      "minLength": 1,
      "title": "Object Label",
      "type": "string"
    },
    "object_node_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/SemanticNodeType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "predicate": {
      "$ref": "#/$defs/SemanticPredicate"
    },
    "rationale_code": {
      "minLength": 1,
      "title": "Rationale Code",
      "type": "string"
    },
    "subject": {
      "minLength": 1,
      "title": "Subject",
      "type": "string"
    }
  },
  "required": [
    "assertion_id",
    "subject",
    "predicate",
    "object_label",
    "explicitness",
    "evidence",
    "rationale_code",
    "confidence"
  ],
  "title": "SilverSemanticAssertion",
  "type": "object"
}
