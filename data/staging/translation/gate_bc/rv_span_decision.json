     "VG:RV:SAK:M10:S061:V008"
    ],
    "question": "Griffith renders explicit passages into Latin. The text is his and is public domain, but it is not an English translation and the rows declare language 'en'. Publish with a language correction and a disclosure, or leave the verses uncovered?",
    "new_decision_id": "OWNER_DECISION_F_LATIN_SUBSTITUTION"
   },
   {
    "scope": "Rigvedic verses with no candidate source",
    "population": 3,
    "keys": [
     "VG:RV:SAK:M08:S093:V029",
     "VG:RV:SAK:M10:S086:V016",
     "VG:RV:SAK:M10:S086:V017"
    ],
    "question": "these are a scope statement, not a gate: no source has been found. They belong in GAP-TRANSLATION-004's residual, not behind an owner decision.",
    "new_decision_id": null
   }
  ]
 },
