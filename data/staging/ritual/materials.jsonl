{"concept_key": "VG:CONCEPT:VRIHI-RICE", "label_en": "rice", "label_sa": "vrīhi", "kind": "MATERIAL", "sub_kind": "PLANT", "node_status": "PROPOSED_NEW", "samhita_attested": true, "samhita_attestation_by_veda": {"AV": 7}, "samhita_attestation_examples": {"AV": ["VG:AV:SAU:K06:S140:V002", "VG:AV:SAU:K08:S002:V018", "VG:AV:SAU:K08:S007:V020", "VG:AV:SAU:K09:S001:V022", "VG:AV:SAU:K10:S006:V024", "VG:AV:SAU:K11:S004:V013"]}, "supplementary_attestation_count": 63, "supplementary_attestation_by_work": {"SBM": 6, "KatySS": 3, "ParGS": 3, "KausS": 12, "PB": 1, "SVidhB": 7, "LatSS": 2, "GobhGS": 8, "AB": 2, "KausB": 2, "AsvSS": 2, "SankhSS": 1, "AsvGS": 6, "SankhGS": 4, "KausGS": 4}, "evidence": [{"supplementary_key": "VG:SUPP:KausS:1:7:5", "citation": "KausS 1.7.5", "evidence_source_type": "GRHYASUTRA", "quote": "āvapati vrīhiyavatilān", "translation": null}, {"supplementary_key": "VG:SUPP:GobhGS:1:4:22", "citation": "GobhGS 1.4.22", "evidence_source_type": "GRHYASUTRA", "quote": "yady ekasmin kāle vrīhiyavau prakriyeyātam anyatarasya hṛtvā kṛtaṃ manyeta", "translation": "[*22] If rice and barley are prepared for one and the same meal, he should, having offered (Balis) of the one or the other (kind of food), consider his duty as fulfilled."}, {"supplementary_key": "VG:SUPP:SVidhB:1:3:8", "citation": "SVidhB 1.3.8", "evidence_source_type": "BRAHMANA", "quote": "karmānte 'gniṃ pratiṣṭhāpya vrīhiyavāṃs taṇḍulāṃs triḥ prakṣālya juhuyāt / agnaye svāhā / somāya pavitravate / varuṇāya dhanvantaraye / manasā prājāpatyāṃ brahmaṇe / agnaye sviṣṭakṛta iti paścāt", "translation": null}], "existence_evidence_type": "SAMHITA"}
