{"concept_key": "VG:CONCEPT:TILA-SESAME", "label_en": "sesame", "label_sa": "tila", "kind": "MATERIAL", "sub_kind": "PLANT", "node_status": "PROPOSED_NEW", "samhita_attested": true, "samhita_attestation_by_veda": {"AV": 1}, "samhita_attestation_examples": {"AV": ["VG:AV:SAU:K06:S140:V002"]}, "supplementary_attestation_count": 3, "supplementary_attestation_by_work": {"ParGS": 1, "SVidhB": 1, "AsvGS": 1}, "evidence": [{"supplementary_key": "VG:SUPP:ParGS:2:10:17", "citation": "ParGS 2.10.17", "evidence_source_type": "GRHYASUTRA", "quote": "sa yāvantaṃ gaṇam icchet tāvatas tilān ākarṣaphalakena juhuyāt sāvitryā śukrajyotir ity anuvākena vā", "translation": "[*17]. As many pupils as he wishes to obtain, so many sesamum grains should he sacrifice with a dice-board, with the Savitri or with the Anuvaka, 'Bright-resplending' (Vag. Samh. XVII, 80 seqq.)."}, {"supplementary_key": "VG:SUPP:SVidhB:3:5:6", "citation": "SVidhB 3.5.6", "evidence_source_type": "BRAHMANA", "quote": "kṛṣṇāṃs tilān agnau juhuyāt pra daivodāso agnir ity etena / nainaṃ kṛtāni hiṃsanti / tāny eva pratigacchanti", "translation": null}, {"supplementary_key": "VG:SUPP:AsvGS:4:7:11", "citation": "AsvGS 4.7.11", "evidence_source_type": "GRHYASUTRA", "quote": "śaṃ no devīr abhiṣṭaya ity anumantritāsu tilān āvapati tilo 'si soma devatyo gosave devanirmitaḥ / pratnavadbhiḥ prattaḥ svadhayā pitṝn imāṃllokān prīṇayā hi naḥ svadhā nama iti", "translation": null}], "existence_evidence_type": "SAMHITA"}
