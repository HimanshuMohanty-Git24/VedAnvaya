{"concept_key": "VG:CONCEPT:TANDULA-HUSKED-GRAIN", "label_en": "husked grain", "label_sa": "taṇḍula", "kind": "MATERIAL", "sub_kind": "PLANT", "node_status": "PROPOSED_NEW", "samhita_attested": true, "samhita_attestation_by_veda": {"AV": 6}, "samhita_attestation_examples": {"AV": ["VG:AV:SAU:K10:S009:V026", "VG:AV:SAU:K11:S001:V018", "VG:AV:SAU:K11:S003:V005", "VG:AV:SAU:K12:S003:V018", "VG:AV:SAU:K12:S003:V029", "VG:AV:SAU:K12:S003:V030"]}, "supplementary_attestation_count": 27, "supplementary_attestation_by_work": {"KatySS": 5, "ParGS": 2, "VaitS": 1, "KausS": 12, "SVidhB": 1, "GobhGS": 3, "AB": 1, "AsvGS": 1, "SankhGS": 1}, "evidence": [{"supplementary_key": "VG:SUPP:KausS:1:2:7", "citation": "KausS 1.2.7", "evidence_source_type": "GRHYASUTRA", "quote": "avahatya suphalīkṛtān kṛtvā triḥ prakṣālya taṇḍulān agne varur yajñiyas tvādhi arukṣat iti carum adhidadhāti", "translation": null}, {"supplementary_key": "VG:SUPP:KatySS:2:5:6", "citation": "KatySS 2.5.6", "evidence_source_type": "SRAUTASUTRA", "quote": "dhānyam asīti taṇḍulān opya pinaṣṭi prāṇāya tveti pratimantram", "translation": null}, {"supplementary_key": "VG:SUPP:GobhGS:1:7:5", "citation": "GobhGS 1.7.5", "evidence_source_type": "GRHYASUTRA", "quote": "triḥphalīkṛtāṃs taṇḍulān trir devebhyaḥ prakṣālayed ity āhur dvir manuṣyebhyaḥ sakṛt pitṛbhya iti", "translation": "After the grain has three times been winnowed, he should wash it thrice (if it is destined) for the gods, they say, twice, if for men, once, if for the Fathers."}], "existence_evidence_type": "SAMHITA"}
{"concept_key": "VG:CONCEPT:DARBHA-GRASS", "label_en": "darbha grass", "label_sa": "darbha", "kind": "MATERIAL", "sub_kind": "PLANT", "node_status": "PROPOSED_NEW", "samhita_attested": true, "samhita_attestation_by_veda": {"AV": 39, "RV": 1}, "samhita_attestation_examples": {"AV": ["VG:AV:SAU:K06:S043:V001", "VG:AV:SAU:K06:S043:V002", "VG:AV:SAU:K08:S007:V020", "VG:AV:SAU:K10:S004:V002", "VG:AV:SAU:K10:S004:V013", "VG:AV:SAU:K11:S006:V015"], "RV": ["VG:RV:SAK:M01:S191:V003"]}, "supplementary_attestation_count": 131, "supplementary_attestation_by_work": {"SBM": 23, "ParGS": 1, "KausS": 51, "PB": 1, "SadvB": 2, "SVidhB": 1, "LatSS": 5, "GobhGS": 29, "AB": 3, "KausB": 1, "AsvSS": 1, "AsvGS": 6, "SankhGS": 3, "KausGS": 4}, "evidence": [{"supplementary_key": "VG:SUPP:KausS:1:1:27", "citation": "KausS 1.1.27", "evidence_source_type": "GRHYASUTRA", "quote": "pra yaccha parśum iti darbhāhārāya dātraṃ prayacchati", "translation": null}, {"supplementary_key": "VG:SUPP:GobhGS:1:6:13", "citation": "GobhGS 1.6.13", "evidence_source_type": "GRHYASUTRA", "quote": "atha pūrvāhṇa eva prātarāhutiṃ hutvāgreṇāgniṃ parikramya dakṣiṇato 'gneḥ prāgagrān darbhān āstīrya", "translation": "Now in the forenoon, after (the sacrificer) has offered his morning oblation, and has walked round the fire on its front side, and strewn to the south of the fire eastward-pointed Darbha grass--"}, {"supplementary_key": "VG:SUPP:SBM:3:1:2:7:1", "citation": "SBM 3.1.2.7.1", "evidence_source_type": "BRAHMANA", "quote": "atha darbhataruṇakam antardadhāty oṣadhe trāyasveti", "translation": null}], "existence_evidence_type": "SAMHITA"}
{"concept_key": "VG:CONCEPT:KUSA-GRASS", "label_en": "kusa grass", "label_sa": "kuśa", "kind": "MATERIAL", "sub_kind": "PLANT", "node_status": "PROPOSED_NEW", "samhita_attested": false, "samhita_attestation_by_veda": {}, "samhita_attestation_examples": {}, "supplementary_attestation_count": 38, "supplementary_attestation_by_work": {"KatySS": 13, "ParGS": 1, "VaitS": 1, "LatSS": 3, "GobhGS": 2, "AsvSS": 1, "SankhSS": 6, "AsvGS": 1, "SankhGS": 4, "KausGS": 6}, "evidence": [{"supplementary_key": "VG:SUPP:KatySS:1:10:8", "citation": "KatySS 1.10.8", "evidence_source_type": "SRAUTASUTRA", "quote": "kuśair asatsu", "translation": null}, {"supplementary_key": "VG:SUPP:SankhSS:4:4:2", "citation": "SankhSS 4.4.2", "evidence_source_type": "SRAUTASUTRA", "quote": "mekṣaṇam anuprahṛtya dakṣiṇā dakṣiṇāgner apahatā asurā rakṣāṃsi vediṣada iti sphyenonmṛjyābhyukṣya / ye rūpāṇi pratimuñcamānā asurāḥ santaḥ svadhayā caranti / parāpuro nipuro ye bharanty agniṣṭāṃl lokāt pra ṇudāty asmāt / ity ulmukam unmṛṣṭ", "translation": "The pot-ladle he throws after (the oblations) into the fire. Then, having by means of the wooden sword cut up (a spot) to the south of the Dakṣiṇagni with (the formula): \"Driven away are the Asuras (and) the Rakṣasas who sit on the vedi\", and having sprinkled water on it, he puts down on the southern half of the cut up (spot), a firebrand with the verse: \"Whatsoever Asuras roam at will, assuming various shapes, be they laṛge-bodied or small-bodied, may Agni expel them from this place\". On the cut up (spot) he lays down some kuśa grass blades, which are severed (and cut off) at the root by one single stroke and pours with his hand, (with palm) directed downwards, water on this grass with (the formula): \"So and so, and those who are there near to thee, wash (the hands)\" pronouncing (instead of so and so) the name of his Father (of the sacrificer)."}, {"supplementary_key": "VG:SUPP:KausGS:1:3:6", "citation": "KausGS 1.3.6", "evidence_source_type": "GRHYASUTRA", "quote": "dakṣiṇena kuśān ādāya savyenāpanoti", "translation": null}], "existence_evidence_type": "SRAUTASUTRA"}
{"concept_key": "VG:CONCEPT:PALASA-WOOD", "label_en": "palasa wood", "label_sa": "palāśa", "kind": "MATERIAL", "sub_kind": "PLANT", "node_status": "PROPOSED_NEW", "samhita_attested": false, "samhita_attestation_by_veda": {}, "samhita_attestation_examples": {}, "supplementary_attestation_count": 54, "supplementary_attestation_by_work": {"SBM": 6, "KatySS": 7, "ParGS": 2, "VaitS": 1, "KausS": 12, "PB": 1, "SVidhB": 1, "LatSS": 1, "GobhGS": 1, "AB": 2, "KausB": 2, "AsvSS": 1, "SankhSS": 9, "AsvGS": 3, "SankhGS": 1, "KausGS": 4}, "evidence": [{"supplementary_key": "VG:SUPP:KausS:1:8:15", "citation": "KausS 1.8.15", "evidence_source_type": "GRHYASUTRA", "quote": "palāśodumbarajambukāmpīlasragvaṅghaśirīṣasraktyavaraṇabilvajaṅgiḍakuṭakagarhyagalāvalavetasaśimbalasipunasyandanāraṇikāśmayoktatunyupūtudāravaḥ śāntāḥ", "translation": null}, {"supplementary_key": "VG:SUPP:SankhSS:4:14:7", "citation": "SankhSS 4.14.7", "evidence_source_type": "SRAUTASUTRA", "quote": "apeta vīteti palāśaśākhayā vimṛjya", "translation": null}, {"supplementary_key": "VG:SUPP:KatySS:5:10:9", "citation": "KatySS 5.10.9", "evidence_source_type": "SRAUTASUTRA", "quote": "pātryāṃ kṛtvā dakṣiṇāgnyulmukam ādāya catuṣpathe palāśapattramadhyamena homaḥ", "translation": null}], "existence_evidence_type": "BRAHMANA"}
