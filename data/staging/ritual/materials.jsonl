{"concept_key": "VG:CONCEPT:GOMAYA-COWDUNG", "label_en": "cowdung", "label_sa": "gomaya", "kind": "MATERIAL", "sub_kind": "SUBSTANCE", "node_status": "PROPOSED_NEW", "samhita_attested": true, "samhita_attestation_by_veda": {"RV": 1}, "samhita_attestation_examples": {"RV": ["VG:RV:SAK:M10:S062:V002"]}, "supplementary_attestation_count": 26, "supplementary_attestation_by_work": {"ParGS": 4, "KausS": 3, "GobhGS": 5, "SankhSS": 2, "AsvGS": 5, "SankhGS": 2, "KausGS": 5}, "evidence": [{"supplementary_key": "VG:SUPP:GobhGS:1:5:13", "citation": "GobhGS 1.5.13", "evidence_source_type": "GRHYASUTRA", "quote": "atha yad ahar upavasatho bhavati tad ahaḥ pūrvāhṇa eva prātarāhutiṃ hutvaitad agneḥ sthaṇḍilam gomayena samantaṃ paryupalimpati", "translation": "Now on the day which is the fast-day, on that day, in the forenoon, having offered his morning oblation, he besmears that surface on which the fire is placed, on all sides with cow-dung."}, {"supplementary_key": "VG:SUPP:AsvGS:1:17:3", "citation": "AsvGS 1.17.3", "evidence_source_type": "GRHYASUTRA", "quote": "paścāt kārayiṣyamāṇo mātur upastha ānaḍuham gomayaṃ nave śarāve śamīparṇāni ca upanihitāni bhavanti", "translation": null}, {"supplementary_key": "VG:SUPP:KausGS:1:3:2", "citation": "KausGS 1.3.2", "evidence_source_type": "GRHYASUTRA", "quote": "caturaśraṃ gomayena sthaṇḍilam upalipya pūrvayor vidiśayoḥ dakṣiṇāṃ prācīṃ pritrya uttarāṃ daive prācīm evaika udaksaṃsthāṃ madhye rekhāṃ likhitvā tasyā dakṣiṇata upariṣṭād ūrdhvām ekāṃ madhya ekām uttarata ekāṃ tām abhyukṣya agniṃ dadhāmi ", "translation": null}], "existence_evidence_type": "SAMHITA"}
