{"concept_key": "VG:CONCEPT:ASVATTHA-WOOD", "label_en": "asvattha wood", "label_sa": "aśvattha", "kind": "MATERIAL", "sub_kind": "PLANT", "node_status": "PROPOSED_NEW", "samhita_attested": true, "samhita_attestation_by_veda": {"AV": 10, "RV": 2, "YV": 2}, "samhita_attestation_examples": {"AV": ["VG:AV:SAU:K03:S006:V002", "VG:AV:SAU:K03:S006:V005", "VG:AV:SAU:K05:S004:V003", "VG:AV:SAU:K05:S005:V005", "VG:AV:SAU:K06:S011:V001", "VG:AV:SAU:K06:S095:V001"], "RV": ["VG:RV:SAK:M01:S135:V008", "VG:RV:SAK:M10:S097:V005"], "YV": ["VG:YV:VSM:A12:V079", "VG:YV:VSM:A35:V004"]}, "supplementary_attestation_count": 15, "supplementary_attestation_by_work": {"SBM": 1, "KatySS": 1, "GB": 1, "VaitS": 2, "KausS": 3, "GobhGS": 1, "AB": 2, "AsvSS": 2, "SankhSS": 1, "KausGS": 1}, "evidence": [{"supplementary_key": "VG:SUPP:KausS:2:7:11", "citation": "KausS 2.7.11", "evidence_source_type": "GRHYASUTRA", "quote": "aśvatthabadhakayor agniṃ manthati", "translation": null}, {"supplementary_key": "VG:SUPP:VaitS:2:1:7", "citation": "VaitS 2.1.7", "evidence_source_type": "SRAUTASUTRA", "quote": "yo aśvatthaḥ śamīgarbha āruroha tve sacā / taṃ te harāmi brahmaṇā yajñiyaiḥ ketubhiḥ saha / jātavedo bhuvanasya yad reta iha siñca tapaso yaj janiṣyate / agnim aśvatthād adhi havyavāhaṃ śamīgarbhāj janayan yo mayobhūr iti mantrokte araṇī gṛ", "translation": "\"Der mit Śamī verwachsene Asvattha, der mit dir (o Feuerbohrer) zusammen aufgewachsen ist, Den hol' ich dir mit heil'gem Spruch und Opferflammen.\" \"O Jātavedas, den Samen der Welt giess' aus hier, der aus Erhitzung entstehen wird, Indem du aus Śamī-verwachsenem Asvattha das Opferspeise führende Feuer erzeugst, das wunderbare\" (diese beide Strophen) heisst er (der Brahman) den (Opferherrn), der das Vornehmen hat sich die Feuer anzulegen, aussprechen, während er (der Opferherr) die beiden (Reibhölzer) von der Art (d.h. von der Holzsorte), wie im Spruche angedeutet ist, eṛgreift."}, {"supplementary_key": "VG:SUPP:AB:7:32:2", "citation": "AB 7.32.2", "evidence_source_type": "BRAHMANA", "quote": "atha yad āśvatthāni tejaso vā eṣa vanaspatir ajāyata yad aśvatthaḥ sāmrājyaṃ vā etad vanaspatīnām teja evāsmiṃs tat sāmrājyaṃ ca vanaspatīnāṃ kṣatre dadhāti", "translation": null}], "existence_evidence_type": "SAMHITA"}
{"concept_key": "VG:CONCEPT:NYAGRODHA-WOOD", "label_en": "nyagrodha wood", "label_sa": "nyagrodha", "kind": "MATERIAL", "sub_kind": "PLANT", "node_status": "PROPOSED_NEW", "samhita_attested": true, "samhita_attestation_by_veda": {"AV": 2, "YV": 1}, "samhita_attestation_examples": {"AV": ["VG:AV:SAU:K04:S037:V004", "VG:AV:SAU:K05:S005:V005"], "YV": ["VG:YV:VSM:A23:V013"]}, "supplementary_attestation_count": 19, "supplementary_attestation_by_work": {"KatySS": 2, "ParGS": 1, "KausS": 1, "SVidhB": 1, "GobhGS": 4, "AB": 8, "SankhGS": 1, "KausGS": 1}, "evidence": [{"supplementary_key": "VG:SUPP:AB:7:30:2", "citation": "AB 7.30.2", "evidence_source_type": "BRAHMANA", "quote": "athāsyaiṣa svo bhakṣo nyagrodhasyāvarodhāś ca phalāni caudumbarāṇy āśvatthāni plākṣāṇy abhiṣuṇuyāt tāni bhakṣayet so 'sya svo bhakṣaḥ", "translation": null}, {"supplementary_key": "VG:SUPP:GobhGS:2:6:6", "citation": "GobhGS 2.6.6", "evidence_source_type": "GRHYASUTRA", "quote": "prāgudīcyāṃ diśi nyagrodhaśuṅgām ubhayataḥphalām asrāmām akṛmiparisṛptāṃ triḥsaptair yavair māṣair vā parikrīyotthāpayet", "translation": "In a north-easterly direction, having bought for three times seven barley corns or beans a Nyagrodha shoot which. has fruits on both sides, which is not dry and not touched by worms, he should set that up."}, {"supplementary_key": "VG:SUPP:KatySS:10:9:30", "citation": "KatySS 10.9.30", "evidence_source_type": "SRAUTASUTRA", "quote": "vaiśyarājanyayoḥ some nyagrodhastibhīn upanahyechan bhakṣāya krayaṇaprabhṛty anusomam āvṛtā samānam āsādanaṃ prāg abhiṣavāt", "translation": null}], "existence_evidence_type": "SAMHITA"}
{"concept_key": "VG:CONCEPT:VIKANKATA-WOOD", "label_en": "vikankata wood", "label_sa": "vikaṅkata", "kind": "MATERIAL", "sub_kind": "PLANT", "node_status": "PROPOSED_NEW", "samhita_attested": true, "samhita_attestation_by_veda": {"AV": 1}, "samhita_attestation_examples": {"AV": ["VG:AV:SAU:K11:S010:V003"]}, "supplementary_attestation_count": 3, "supplementary_attestation_by_work": {"KatySS": 3}, "evidence": [{"supplementary_key": "VG:SUPP:KatySS:26:2:10", "citation": "KatySS 26.2.10", "evidence_source_type": "SRAUTASUTRA", "quote": "upayamanīṃ mahāvīram parīśāsau pinvane rauhiṇakapāle rauhiṇahavanyau ca srucāvanutkīrṇe sthūṇāmayūkham dhṛṣṭī śatamāne muñjapralavān vikaṅkataśakalān viṃśatiṃ prādeśamātrān sruvaṃ muñjavedam dhavitrāṇi paridhīṃś ca rajjusaṃdānam āsandīṃ kṛṣ", "translation": null}], "existence_evidence_type": "SAMHITA"}
{"concept_key": "VG:CONCEPT:PLAKSA-WOOD", "label_en": "plaksa wood", "label_sa": "plakṣa", "kind": "MATERIAL", "sub_kind": "PLANT", "node_status": "PROPOSED_NEW", "samhita_attested": false, "samhita_attestation_by_veda": {}, "samhita_attestation_examples": {}, "supplementary_attestation_count": 16, "supplementary_attestation_by_work": {"SBM": 4, "KatySS": 2, "PB": 4, "LatSS": 2, "GobhGS": 3, "AB": 1}, "evidence": [{"supplementary_key": "VG:SUPP:SBM:3:8:3:10:6", "citation": "SBM 3.8.3.10.6", "evidence_source_type": "BRAHMANA", "quote": "plakṣaśākhā uttarabarhir bhavanti", "translation": null}, {"supplementary_key": "VG:SUPP:PB:21:4:13", "citation": "PB 21.4.13", "evidence_source_type": "BRAHMANA", "quote": "ekayūpo vaikādaśinī vānyeṣāṃ yajñānāṃ bhavaty ekaviṃśiny aśvamedhasya khādiro vā bailvo vā pārṇo vā 'nyeṣāṃ yajñānāṃ bhavati naicudāra ekaviṃśatyaratnir aśvamedhasya nānyeṣāṃ paśūnāṃ tejanyā avadyanty avadyanty aśvamedhasya dakṣiṇato 'nyeṣā", "translation": null}, {"supplementary_key": "VG:SUPP:GobhGS:4:1:9", "citation": "GobhGS 4.1.9", "evidence_source_type": "GRHYASUTRA", "quote": "plakṣaśākhāvati prastare 'vadānāni kṛtvā", "translation": "And having placed the Avadanas on a layer (of grass) on which branches of the Plaksha (tree) have been spread,"}], "existence_evidence_type": "BRAHMANA"}
